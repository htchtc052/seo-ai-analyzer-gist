APP_DOMAIN=seo-analyzer.proclouds.ru

# Где на сервере лежит репозиторий первой версии — путь относительно infra/.
V1_REPO_PATH=../../seo-ai-analyzer

# Postgres живёт на хосте, а не в Docker. Роль и обе базы заводятся руками,
# см. DEPLOY.md. Пароль только hex — он попадает в строку подключения.
POSTGRES_USER=seo
POSTGRES_PASSWORD=
POSTGRES_DB_V1=seo_v1
POSTGRES_DB_V2=seo_v2

# Redis общий, версии разведены номером логической базы.
REDIS_PASSWORD=

LLM_BASE_URL=https://api.timeweb.ai/v1
LLM_API_KEY=
LLM_EMBEDDING_MODEL=openai/text-embedding-3-large
# Рекомендации первой версии выключены, пока пусто.
LLM_CHAT_MODEL=
