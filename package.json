{
  "name": "seo-ai-analyzer-gist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @seo-ai-analyzer-gist/api\" \"npm run dev -w @seo-ai-analyzer-gist/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write apps docs README.md"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.0",
    "typescript": "^5.9.3"
  }
}
