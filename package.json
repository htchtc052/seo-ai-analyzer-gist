{
  "name": "seo-ai-analyzer-gist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:v1": "concurrently -k -n v1-api,v1-web \"npm run dev -w @seo/v1-api\" \"npm run dev -w @seo/v1-web\"",
    "dev:v2": "concurrently -k -n v2-api,v2-web \"npm run dev -w @seo/v2-api\" \"npm run dev -w @seo/v2-web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write apps docs README.md"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.0",
    "typescript": "^5.9.3"
  }
}
