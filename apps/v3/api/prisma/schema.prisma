generator client {
  provider = "prisma-client-js"
  // Свой клиент на версию: общий node_modules один на монорепу,
  // и без этого версии перетирают сгенерированные типы друг друга.
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum PageSource {
  PRIMARY
  COMPETITOR
}

enum FailureReason {
  UNREACHABLE
  EMPTY
  INTERNAL
}

// Страницы известны сразу из формы, поэтому адреса живут только в них:
// отдельных колонок с теми же адресами на анализе нет.
model Analysis {
  id             String         @id @default(uuid())
  searchQuery    String
  status         AnalysisStatus @default(QUEUED)
  embeddingModel String?
  selectionObjective Float?
  selectionUtility   Float?
  selectionDiversity Float?
  failureReason  FailureReason?
  failureUrl     String?
  failureDetail  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  completedAt    DateTime?
  pages          AnalysisPage[]

  @@index([createdAt])
}

model AnalysisPage {
  id         String     @id @default(uuid())
  analysisId String
  source     PageSource
  position   Int
  url           String
  title         String?
  embeddedAt    DateTime?
  failureReason FailureReason?
  failureDetail String?
  analysis      Analysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  fragments  Fragment[]

  @@unique([analysisId, source, position])
  @@index([analysisId])
}

// Разрыв, новизна и приоритет — производные, поэтому не хранятся:
// считаются из relevance и similarity при чтении отчёта.
model Fragment {
  id             String       @id @default(uuid())
  pageId         String
  sectionIndex   Int
  paragraphIndex Int
  heading        String?
  text           String       @db.Text
  embedding      Float[]      @default([])
  relevance      Float?
  similarity     Float?
  selectedRank   Int?
  page           AnalysisPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, sectionIndex, paragraphIndex])
  @@index([pageId])
}
