{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@examples/*": ["../examples/*"]
    },
    "types": ["vite/client"],
    "resolveJsonModule": true
  },
  "include": ["src", "vite.config.ts"]
}
