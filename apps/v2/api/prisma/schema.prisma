generator client {
  provider = "prisma-client-js"
  // Свой клиент на версию: общий node_modules один на монорепу,
  // и без этого версии перетирают сгенерированные типы друг друга.
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AnalysisStatus {
  QUEUED
  CRAWLING
  CRAWLED
  ANALYZING
  COMPLETED
  FAILED
}

enum PageSource {
  PRIMARY
  COMPETITOR
}

enum FailureSite {
  PRIMARY
  COMPETITOR
}

enum FailureReason {
  UNREACHABLE
  EMPTY
  INTERNAL
}

model Analysis {
  id                String         @id @default(uuid())
  searchQuery       String
  primarySiteUrl    String
  competitorSiteUrl String
  crawlPagesPerSite Int
  status            AnalysisStatus @default(QUEUED)
  crawledPages      Int            @default(0)
  embeddingModel    String?
  failureSite       FailureSite?
  failureReason     FailureReason?
  failureUrl        String?
  failureDetail     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  completedAt       DateTime?
  pages             AnalysisPage[]

  @@index([createdAt])
  @@index([status])
}

model AnalysisPage {
  id         String      @id @default(uuid())
  analysisId String
  source     PageSource
  position   Int
  url        String
  title      String
  pageDate       DateTime?
  pageDateSource String?
  sitemapLastmod DateTime?
  embeddedAt DateTime?
  analysis   Analysis    @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  fragments  Fragment[]

  @@unique([analysisId, source, position])
  @@index([analysisId])
}

model Fragment {
  id                       String     @id @default(uuid())
  pageId                   String
  sectionIndex             Int
  paragraphIndex           Int
  heading                  String?
  text                     String     @db.Text
  embedding                Float[]    @default([])
  relevance                Float?
  maxPrimarySimilarity     Float?
  closestPrimaryFragmentId String?
  page                     AnalysisPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  closestPrimaryFragment   Fragment?  @relation("ClosestPrimary", fields: [closestPrimaryFragmentId], references: [id], onDelete: SetNull)
  competitorMatches        Fragment[] @relation("ClosestPrimary")

  @@unique([pageId, sectionIndex, paragraphIndex])
  @@index([pageId])
  @@index([closestPrimaryFragmentId])
}
